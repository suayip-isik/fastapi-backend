# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME="My FastAPI App"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_VERSION=1.0.0
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=strongpassword
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT / Auth ──────────────────────────────────────────────────────────────
# RS256: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Cookie ─────────────────────────────────────────────────────────────────
COOKIE_DOMAIN=                # boş = request domain kullanılır
COOKIE_SECURE=false           # production'da true olmalı
COOKIE_SAMESITE=lax           # lax | strict | none

# ─── Storage (S3 / MinIO) ────────────────────────────────────────────────────
STORAGE_BACKEND=minio         # minio | s3 | local
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=app-uploads
S3_REGION=us-east-1
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=["image/jpeg","image/png","image/webp","application/pdf"]

# ─── Seed Users ───────────────────────────────────────────────────────────────
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=changeme
DEFAULT_APP_USER_USERNAME=suayip
DEFAULT_APP_USER_EMAIL=suayip@example.com
DEFAULT_APP_USER_PASSWORD=changeme
DEFAULT_APP_USER_FULL_NAME=Suayip

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute        # login + reset-password
RATE_LIMIT_AUTH_EMAIL=3/hour    # forgot-password + resend-verification + admin invite
RATE_LIMIT_REGISTER=3/hour      # yalnız client self-register
RATE_LIMIT_UPLOAD=20/hour
RATE_LIMIT_API_KEYS=20/minute

# ─── Email (isteğe bağlı) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@example.com

# ─── Sentry (isteğe bağlı) ───────────────────────────────────────────────────
SENTRY_DSN=                   # https://xxx@sentry.io/yyy
SENTRY_TRACES_SAMPLE_RATE=0.1 # 0.0 = kapalı, 1.0 = tüm istekler

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json               # json | text
